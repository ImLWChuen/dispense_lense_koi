# DispenseLens Local Environment Configuration Template
# Copy this file to .env for local development (do NOT commit .env).

# ------------------------------------------------------------------------------
# 1. Database Configuration (PostgreSQL with psycopg 3 driver)
# ------------------------------------------------------------------------------
# Format: postgresql+psycopg://<user>:<password>@<host>:<port>/<dbname>
DATABASE_URL=postgresql+psycopg://dispenselens_user:dispenselens_dev_password@localhost:5432/dispenselens

# Separate disposable test database destination for automated test execution.
# Tests MUST target a disposable database (e.g. dispenselens_test) and will fail
# closed if missing, remote, redirected, or pointing to the development database above.
TEST_DATABASE_URL=postgresql+psycopg://dispenselens_user:dispenselens_dev_password@localhost:5432/dispenselens_test

# ------------------------------------------------------------------------------
# 2. CORS Allowed Origins (Comma-separated for Next.js frontend integration)
# ------------------------------------------------------------------------------
# Default frontend port is 3001 (port 3000 is retained for backward compatibility)
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:3001,http://127.0.0.1:3001,http://localhost:8000,http://127.0.0.1:8000

# ------------------------------------------------------------------------------
# 3. Bounded LLM Configuration (OpenAI, optional: offline fallback if unset)
# ------------------------------------------------------------------------------
# Set your OpenAI API key here (or via generic LLM_API_KEY)
OPENAI_API_KEY=

# Model identifier (e.g. gpt-4o, gpt-4o-mini)
OPENAI_MODEL=gpt-4o-mini

# Request timeout in seconds
LLM_TIMEOUT_SECONDS=10.0
