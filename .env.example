# DispenseLens Local Environment Configuration Template
# Copy this file to .env for local development (do NOT commit .env).

# Database connection URL for PostgreSQL (psycopg 3 driver)
# Format: postgresql+psycopg://<user>:<password>@<host>:<port>/<dbname>
DATABASE_URL=postgresql+psycopg://dispenselens_user:dispenselens_dev_password@localhost:5432/dispenselens
