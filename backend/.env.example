# DispenseLens Local Environment Configuration Template (Backend)
# Copy this file to .env in this directory or repository root (do NOT commit .env).

# ------------------------------------------------------------------------------
# 1. Database Configuration (PostgreSQL with psycopg 3 driver)
# ------------------------------------------------------------------------------
# Format: postgresql+psycopg://<user>:<password>@<host>:<port>/<dbname>
DATABASE_URL=postgresql+psycopg://dispenselens_user:dispenselens_dev_password@localhost:5432/dispenselens

# ------------------------------------------------------------------------------
# 2. CORS Allowed Origins (Comma-separated for Next.js frontend integration)
# ------------------------------------------------------------------------------
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:8000,http://127.0.0.1:8000

# ------------------------------------------------------------------------------
# 3. Bounded LLM Configuration (Optional: Offline/deterministic fallback if unset)
# ------------------------------------------------------------------------------
# Set your Gemini API key here or via GEMINI_API_KEY / LLM_API_KEY
GEMINI_API_KEY=

# Model identifier (e.g. gemini-1.5-flash, gemini-1.5-pro, gemini-2.0-flash)
GEMINI_MODEL=gemini-1.5-flash

# Custom API Base URL (defaults to Google Generative Language API, or set to proxy/gateway)
GEMINI_API_BASE=https://generativelanguage.googleapis.com/v1beta

# Request timeout in seconds
LLM_TIMEOUT_SECONDS=10.0
