{
  "questions": [
    {
      "id": "Q01",
      "text": "Does the problem occur immediately after startup or only after the machine has been running for a while?",
      "purpose": "Distinguishes thermal/time-related causes (air expansion, material viscosity change) from static issues.",
      "applicable_causes": ["air_supply_issue", "material_condition", "pressure_instability", "temperature_issue"],
      "applicable_defects": ["D01_TOO_LITTLE", "D02_TOO_MUCH", "D03_INCONSISTENT_SIZE", "D04_MISSING_DOTS", "D05_SPREADING"],
      "expected_answer_type": "categorical",
      "evidence_mapping": {
        "after_prolonged_operation": {
          "air_supply_issue": {"relation": "SUPPORTS", "strength": "STRONG"},
          "material_condition": {"relation": "SUPPORTS", "strength": "MODERATE"},
          "temperature_issue": {"relation": "SUPPORTS", "strength": "STRONG"},
          "nozzle_restriction": {"relation": "NEUTRAL", "strength": "WEAK"},
          "pressure_instability": {"relation": "SUPPORTS", "strength": "MODERATE"}
        },
        "immediately": {
          "air_supply_issue": {"relation": "NEUTRAL", "strength": "WEAK"},
          "parameter_issue": {"relation": "SUPPORTS", "strength": "MODERATE"},
          "nozzle_restriction": {"relation": "SUPPORTS", "strength": "MODERATE"},
          "equipment_condition": {"relation": "SUPPORTS", "strength": "MODERATE"}
        }
      }
    },
    {
